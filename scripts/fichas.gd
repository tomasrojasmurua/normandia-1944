## La ficha de un hombre: {de, antes, porque, frase, dicen: [quién, qué]}.
static func de(nombre: String) -> Dictionary:
	var n := nombre.to_upper()
	if ESCRITAS.has(n):
		return ESCRITAS[n]
	var h := absi(hash(n))
	var quien := "BRENNAN" if n != "BRENNAN" else "DELUCA"
	var vivos: Array = Compania.hombres.filter(func(x: Dictionary) -> bool:
		return x["estado"] != "muerto" and x["n"] != n)
	if not vivos.is_empty():
		quien = vivos[(h / 7) % vivos.size()]["n"]
	return {
		"de": _DE[h % _DE.size()],
		"antes": _ANTES[(h / 3) % _ANTES.size()],
		"porque": _PORQUE[(h / 5) % _PORQUE.size()],
		"frase": _FRASE[(h / 11) % _FRASE.size()],
		"dicen": [quien, _DICEN[(h / 13) % _DICEN.size()]],
	}
