; Normandy 1944 - archivo de proyecto de Godot.
; No hace falta editarlo a mano: Godot lo modifica solo desde el editor.

config_version=5

[application]

config/name="Normandy 1944"
config/description="FPS cooperativo retro de la Segunda Guerra Mundial."
config/version="0.28.3"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/icon_512.png"

[autoload]

Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/default_font_antialiasing=0

